{
  "name": "@amragrir/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Internal back office — owner + admin roles in one RBAC-gated React+Vite SPA (no SEO/SSR need). Split into separate owner/admin apps later only if scale demands it.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@amragrir/shared": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
