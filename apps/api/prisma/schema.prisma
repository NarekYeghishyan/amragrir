// Amragrir.am database schema — see docs/DATABASE.md for the source of truth.
// Money is stored as AMD integer (dram has no minor unit). Timestamps are timestamptz.
// Keep this schema and docs/DATABASE.md in sync; log changes in docs/CHANGELOG.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (mirror packages/shared/src/enums.ts) ──────────────────────────────
// `guest` is not a DB role — it is the `users.isGuest` flag (see ROLES_AND_PERMISSIONS.md).

/// What a *customer* account is. `owner`/`staff`/`admin` are retired: staff are
/// separate accounts in `staff_users` with roles in `staff_assignments`. The
/// values stay until the `/owner` and `/admin` endpoints move onto staff tokens,
/// because dropping an enum value out from under live rows is not a migration.
enum Role {
  customer
  owner
  staff
  admin
}

/// A back-office role. What each may do is ROLE_PERMISSIONS in
/// packages/shared/src/staff-roles.ts — deliberately not a table, since a
/// permission is only real next to an endpoint that checks it.
enum StaffRole {
  super_admin
  platform_admin
  restaurant_admin
  restaurant_manager
  branch_staff
}

enum ServiceMode {
  pickup
  dine_in
}

/// What a guest does with a pickup order — see `orders.pickup_option`. A
/// sub-mode of `pickup`, not a fourth service mode: the order is a pickup order
/// either way, and this only says where the food ends up.
enum PickupOption {
  take_away
  eat_in
}

enum OrderStatus {
  created
  paid
  confirmed
  preparing
  almost_ready
  ready
  completed
  cancelled
}

/// What an `order_events` row records. `payment` is for the attempts that leave
/// the order where it is — a decline is not a status change.
enum OrderEventType {
  created
  status_changed
  payment
  /// A branch moved when it wants warning about a pre-order — see
  /// `orders.reminder_lead_min`. Not a status change: the order stays where it
  /// is, and this is the only record of a column that is overwritten in place.
  reminder_set
}

/// Who is behind an `order_events` row. Three tables, not one nullable user id:
/// a customer is `users`, a staff member is `staff_users`, and `system` is
/// neither.
enum OrderActorType {
  customer
  staff
  system
}

enum ReservationStatus {
  pending
  confirmed
  seated
  completed
  cancelled
  no_show
}

/// What one dated exception does to a branch's booking day — see
/// `branch_closures`. Two kinds rather than a nullable pair of times, so a row
/// with no hours on it is a shut day by construction rather than by convention.
enum ClosureKind {
  /// No bookings that day at all: a holiday, a private hire, a burst pipe.
  closed
  /// Open, but not on the usual hours — the short day before a holiday, the
  /// late night after a match.
  custom_hours
}

/// Every method is online. `cash` was removed once an order stopped being
/// placeable without paying for it — see BUSINESS_LOGIC.md §5.
enum PaymentMethod {
  apple_pay
  google_pay
  card
}

enum PaymentStatus {
  pending
  authorized
  captured
  refunded
  failed
  cancelled
}

enum NotificationType {
  order
  reservation
  promo
  referral
  system
}

/// What a `staff_notifications` row is telling a branch about. One value so far;
/// it is an enum rather than a string so the panel's rendering is exhaustive and
/// a second kind cannot be added without the switch failing to compile.
enum StaffNotificationType {
  /// A pre-order is about to need cooking — see `orders.reminder_at`.
  prep_due

  /// Somebody has paid for an order the restaurant has not accepted yet.
  ///
  /// Only ever an **immediate** order. A pre-order is accepted the moment it is
  /// paid for (`payments.service.ts`), precisely so it does not sit unanswered
  /// for five days, and it is announced later by `prep_due` when the work is
  /// actually in front of somebody. An immediate order is the opposite case:
  /// it stays `paid` until a human says yes, with a diner watching a screen
  /// that says the restaurant has not looked at it — and until now nothing
  /// interrupted anybody to say so.
  order_placed

  /// A table has been booked and the branch has not accepted it yet.
  ///
  /// Only where the branch asked to read every booking first
  /// (`booking_policies.auto_confirm` off). A booking that confirmed itself has
  /// no decision waiting on anybody and simply appears in the book — the same
  /// line `order_placed` draws between work that needs an answer now and work
  /// that does not.
  booking_placed
}

enum CouponSource {
  referral
  reward
  promo
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  // Nullable because guest accounts exist before any phone is known; it is
  // filled in when the user verifies an OTP (guest -> customer upgrade).
  phone         String?  @unique @db.VarChar(20)
  phoneVerified Boolean  @default(false) @map("phone_verified")
  name          String?  @db.VarChar(120)
  email         String?  @unique @db.VarChar(160)
  avatarUrl     String?  @map("avatar_url")
  language      String   @default("hy") @db.VarChar(2)
  darkMode      Boolean  @default(false) @map("dark_mode")
  notifPush     Boolean  @default(true) @map("notif_push")
  notifPromo    Boolean  @default(false) @map("notif_promo")
  rewardPoints  Int      @default(0) @map("reward_points")
  role          Role     @default(customer)
  referredById  String?  @map("referred_by") @db.Uuid
  isGuest       Boolean  @default(false) @map("is_guest")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  referredBy       User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]         @relation("UserReferrals")
  ownedRestaurants Restaurant[]   @relation("OwnedRestaurants")
  orders           Order[]
  reservations     Reservation[]
  favorites        Favorite[]
  favoriteDishes   FavoriteMenuItem[]
  reviews          Review[]
  notifications    Notification[]
  referral         Referral?
  coupons          Coupon[]
  orderEvents      OrderEvent[]   @relation("OrderEventActor")

  @@map("users")
}

model Restaurant {
  id                  String   @id @default(uuid()) @db.Uuid
  slug                String   @unique @db.VarChar(80)
  name                String   @db.VarChar(160)
  cuisine             String?  @db.VarChar(120)
  priceLevel          Int?     @map("price_level") @db.SmallInt
  ratingAvg           Decimal  @default(0) @map("rating_avg") @db.Decimal(2, 1)
  reviewsCount        Int      @default(0) @map("reviews_count")
  /// Historical. Who administers a restaurant is a `restaurant_admin` row in
  /// `staff_assignments` — a set, not a single id, which is what makes two
  /// administrators or a handover expressible. Kept nullable so restaurants
  /// whose original owner had no email (and so could not be migrated into
  /// `staff_users`) still record who to invite.
  ownerId             String?  @map("owner_id") @db.Uuid
  /// The business's default, inherited by every branch that has not answered
  /// for itself (`restaurant_branches.reservations_enabled`).
  reservationsEnabled Boolean  @default(false) @map("reservations_enabled")
  /// The business's default services, inherited by every branch whose
  /// `services_overridden` is false. What a guest is actually offered is always
  /// the *branch's* resolved set — see `resolveBranchOffering` in
  /// `@amragrir/shared`.
  services            String[]
  /// The business's default cover, worn by every branch that has none of its
  /// own.
  coverUrl            String?  @map("cover_url")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         User?              @relation("OwnedRestaurants", fields: [ownerId], references: [id])
  branches      RestaurantBranch[]
  reviews       Review[]
  favorites     Favorite[]
  assignments   StaffAssignment[]
  invites       StaffInvite[]
  auditEntries  AuditLog[]
  bookingPolicy BookingPolicy?

  @@index([ownerId])
  @@map("restaurants")
}

model RestaurantBranch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String?  @db.VarChar(160)
  address      String?
  city         String   @default("Yerevan") @db.VarChar(80)
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  phone        String?  @db.VarChar(20)
  openHours    Json?    @map("open_hours")
  isOpen       Boolean  @default(true) @map("is_open")
  avgPrepMin   Int?     @map("avg_prep_min") @db.SmallInt

  /// This branch's own cover, or NULL to wear the restaurant's
  /// (`restaurants.cover_url`). Branches of one business are photographed
  /// separately or not at all, so the parent is the default rather than the
  /// answer — a chain sets one picture once and any branch that differs says so.
  ///
  /// There is deliberately no "explicitly blank" state here: a branch with no
  /// photograph of its own falls back, because a card showing nothing while the
  /// business has a picture is worse than showing the business's.
  coverUrl String? @map("cover_url")

  /// What this branch offers, when `services_overridden` is true. Meaningless
  /// otherwise — read `services_overridden` first.
  ///
  /// The rules in `checkServices` (BUSINESS_LOGIC.md §2) apply per branch, since
  /// each set now describes one address rather than the business.
  /// `@default([])` because the migration that added this column gave it one
  /// (`20260804120000_branch_level_offering`). Declared here so the schema tells
  /// the truth about the database: without it every `migrate dev` generates an
  /// `ALTER COLUMN ... DROP DEFAULT` nobody asked for.
  services String[] @default([])

  /// Whether `services` above is this branch's answer or the restaurant's.
  ///
  /// A flag rather than a nullable `services` because **Postgres arrays are
  /// nullable but Prisma scalar lists are not**, and because `{}` is already a
  /// legitimate value: every restaurant is created having declared nothing, and
  /// a branch must be able to override a parent that offers pickup with a
  /// genuinely empty set. Two columns for one concept is the price of being able
  /// to tell "declared nothing" from "not declared".
  servicesOverridden Boolean @default(false) @map("services_overridden")

  /// Whether this branch takes table bookings, or NULL to follow the
  /// restaurant's `reservations_enabled`. Moved down with `services` because
  /// `reserve` is one of them: a branch offering `reserve` while the business
  /// flag said otherwise would be two answers to "can I book a table here".
  reservationsEnabled Boolean? @map("reservations_enabled")

  /// When this branch takes bookings, or NULL to take them whenever the kitchen
  /// is open (`open_hours`). Same shape as that column.
  ///
  /// A second set of hours rather than a reinterpretation of the first, because
  /// they answer different questions: `open_hours` is when food is served, this
  /// is when a table may be *held*. A place that serves from 10:00 but only
  /// books the dining room for dinner had no way to say so — it had to lie
  /// about its opening time, and the lie showed up on the public card.
  ///
  /// NULL is the common case and stays the default: most kitchens book every
  /// hour they are open, and a branch should not have to restate its hours to
  /// mean "the same".
  bookingHours Json? @map("booking_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables        Table[]
  menuSections  BranchMenuSection[]
  menuItems     MenuItem[]
  orders        Order[]
  reservations  Reservation[]
  favorites     Favorite[]
  assignments   StaffAssignment[]
  invites       StaffInvite[]
  auditEntries  AuditLog[]
  notifications StaffNotification[]
  closures      BranchClosure[]
  bookingPolicy BookingPolicy?

  @@index([restaurantId])
  @@index([lat, lng])
  /// Finding the branches that answer for themselves — created by hand in
  /// `20260804120000_branch_level_offering` and never declared, so `migrate dev`
  /// kept proposing to drop it.
  @@index([servicesOverridden])
  @@map("restaurant_branches")
}

/// One day this branch does not run on its usual hours.
///
/// Dated exceptions to the weekly grid, and the reason the grid can stay a
/// weekly grid: a holiday, a private hire, a short day before New Year. Read
/// *before* `booking_hours` and `open_hours` — see `bookingWindowFor`.
///
/// A table rather than more JSON on the branch, because these rows are queried
/// by date ("what is closed this month"), deleted individually, and attributed
/// to whoever added them. None of that is comfortable inside a JSON column.
model BranchClosure {
  id       String      @id @default(uuid()) @db.Uuid
  branchId String      @map("branch_id") @db.Uuid
  /// The **local calendar date in Yerevan**, not an instant. A closure is a day
  /// off, and a day off does not have a timezone — it is whatever the people
  /// unlocking the door call today.
  date     DateTime    @db.Date
  kind     ClosureKind
  /// Minutes from local midnight, set exactly when `kind` is `custom_hours` and
  /// NULL otherwise. A CHECK constraint holds them to that; Prisma cannot
  /// express it, so it lives in the migration and in DATABASE.md §5.
  ///
  /// `closes_minutes` may exceed 1440, which is how a night that ends after
  /// midnight is written — see `openWindowFor`.
  opensMinutes  Int?    @map("opens_minutes") @db.SmallInt
  closesMinutes Int?    @map("closes_minutes") @db.SmallInt
  /// Why, in whatever words the person typed. Shown back in the panel, because
  /// "closed" with no reason attached is a row nobody dares delete.
  reason        String? @db.VarChar(200)
  /// Who added it. Nullable rather than required: a closure written by a
  /// migration or a seed has no staff member behind it, and inventing one would
  /// be worse than admitting there was none.
  createdByStaffId String? @map("created_by_staff_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// One answer per day. A branch that is both shut and on short hours the same
  /// day is two people having edited the same date, and the second edit should
  /// replace the first rather than sit beside it.
  @@unique([branchId, date])
  @@map("branch_closures")
}

/// Booking rules for one restaurant, or for one branch.
///
/// **Every column is nullable, and NULL means "inherit".** The chain is
/// platform constants → restaurant → branch, resolved in exactly one place:
/// `resolveBookingPolicy` in `@amragrir/shared`. A chain sets its deposit once;
/// the one branch with a two-hour seating overrides that field and no other.
/// Changing a platform constant then still moves every restaurant that never
/// disagreed with it, which is what makes the defaults worth having.
///
/// **One table for both levels**, with two nullable owners and a CHECK that
/// exactly one is set — the same shape `payments` uses for order-or-reservation.
/// Two tables with identical columns would be the same schema written twice,
/// and the resolver would have to know which was which.
///
/// A row is created lazily, on the first save. Its absence and a row of all
/// NULLs mean the same thing, and neither is a state anything has to special-case.
model BookingPolicy {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String? @unique @map("restaurant_id") @db.Uuid
  branchId     String? @unique @map("branch_id") @db.Uuid

  /// How long one booking holds its table. This is what makes 19:00 and 19:30
  /// collide; the slot spacing below does not.
  seatingMinutes Int? @map("seating_minutes") @db.SmallInt
  /// The spacing of the times offered — the grain of the offer, not the length
  /// of the booking.
  slotMinutes    Int? @map("slot_minutes") @db.SmallInt
  /// The largest party one booking may ask for. Not derived from the biggest
  /// table: a branch may cap parties below what it could physically seat.
  maxGuests      Int? @map("max_guests") @db.SmallInt
  /// How far ahead the calendar runs, in days.
  maxLeadDays    Int? @map("max_lead_days") @db.SmallInt
  /// How close to the sitting a booking may still be made, in minutes. Without
  /// it a table can be claimed a minute before the guest walks in, which is not
  /// a booking — it is a surprise.
  minLeadMinutes Int? @map("min_lead_minutes") @db.SmallInt
  /// The deposit per guest, in AMD. Held, never charged as an extra — see
  /// BUSINESS_LOGIC.md §3.
  depositPerGuestAmd Int? @map("deposit_per_guest_amd")
  /// Cancel this many hours ahead and the deposit comes back.
  freeCancelHours    Int? @map("free_cancel_hours") @db.SmallInt
  /// Whether a paid booking confirms itself, or waits for somebody to say yes.
  autoConfirm        Boolean? @map("auto_confirm")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("booking_policies")
}

model Table {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  tableNo  String  @map("table_no") @db.VarChar(10)
  seats    Int     @db.SmallInt
  zone     String? @db.VarChar(40)
  isActive Boolean @default(true) @map("is_active")

  branch       RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  /// Two tables numbered 5 in one room is not a configuration, it is a typo —
  /// and the moment it is discovered is the moment somebody is standing with a
  /// guest looking for table 5. Scoped to the branch, because table 5 exists at
  /// every address a chain has.
  @@unique([branchId, tableNo])
  @@index([branchId])
  @@map("tables")
}

/// The platform's own vocabulary of food — "Pizza", "Sushi", "Healthy".
///
/// **This is the city's index, not a restaurant's menu.** It is what the chip
/// rail on the home screen offers, what `?category=` filters by and what a
/// guest reasons in before they have picked a place. That is why the list is
/// closed and platform-owned: only `categories:write` (super admin) may add to
/// it, so it cannot fill up with "Пицца", "ПИЦЦА" and "Pizza 🍕" as three
/// separate ways to find the same dinner. How a branch *lays out* its own menu
/// is the other axis entirely — `branch_menu_sections`.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  /// The API contract and the deep link. Renaming a category never touches it:
  /// `name_i18n` is the shop window, this is the address.
  key       String   @unique @db.VarChar(40)
  icon      String?  @db.VarChar(8)
  sortOrder Int?     @map("sort_order") @db.SmallInt
  nameI18n  Json     @map("name_i18n")
  /// Off the rail without being deleted. A category that dishes point at cannot
  /// be removed — deleting it would orphan them out of every filter — so
  /// retiring one is this flag, and the dishes keep their category until their
  /// restaurant moves them.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItems MenuItem[]
  sections  BranchMenuSection[]

  @@map("categories")
}

/// One heading on one branch's menu page — "Mains", "Сеты", "Խորոված".
///
/// The branch's own vocabulary, which is why it is a table per branch and not
/// an enum: `menu_tab` used to be one, fixed at four values, and a kitchen
/// whose menu names five things had nowhere to put the fifth.
///
/// `category_id` is the bridge to the other axis. A section that answers "this
/// whole shelf is pizza" gives every dish under it a platform category for
/// free; a section like "Сеты" that answers nothing leaves each dish to name
/// its own. Between the two, no dish ends up invisible to the city's filters —
/// which is exactly what `menu_items.category_id` being optional and unset used
/// to do, silently.
model BranchMenuSection {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  /// The platform category every dish here inherits, or NULL for a section that
  /// does not map onto one. See `effectiveCategoryId` in `@amragrir/shared`.
  categoryId String?  @map("category_id") @db.Uuid
  nameI18n   Json     @map("name_i18n")
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  /// Removed from the menu without leaving the database, for the same reason
  /// `menu_items.deleted_at` exists: withdrawn dishes still point here, and
  /// `order_items` still point at them. A heading emptied of live dishes can
  /// always be retired; one still holding food is refused until it is moved.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  items    MenuItem[]

  @@index([branchId, sortOrder])
  @@index([categoryId])
  @@map("branch_menu_sections")
}

model MenuItem {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  /// The dish's own platform category, which **overrides** its section's. Left
  /// NULL the dish inherits (the common case). Set, it is the escape hatch for
  /// the salad on a grill house's "Мангал" shelf.
  categoryId   String?   @map("category_id") @db.Uuid
  /// Which heading on this branch's page the dish sits under. Required: a dish
  /// that belongs to no section is a dish nobody can find on the menu it is
  /// printed on.
  sectionId    String    @map("section_id") @db.Uuid
  /// On the "Popular" shelf, which is a *showcase* and not a section — a dish
  /// is popular **as well as** being pizza, never instead of it. It was a fifth
  /// value of the old `menu_tab` enum, which forced exactly that false choice
  /// and hid every bestseller from the category it actually belongs to.
  isPopular    Boolean   @default(false) @map("is_popular")
  nameI18n     Json      @map("name_i18n")
  descI18n     Json?     @map("desc_i18n")
  priceAmd     Int       @map("price_amd")
  caloriesKcal Int?      @map("calories_kcal")
  prepMin      Int?      @map("prep_min") @db.SmallInt
  photoUrl     String?   @map("photo_url")
  dietaryTags  String[]  @map("dietary_tags")
  isAvailable  Boolean   @default(true) @map("is_available")
  /// Off the menu, without leaving the database — `order_items` points here, and
  /// an order that can no longer say what was bought is not an order. Set means
  /// gone: every read path filters it out, including the public menu and the
  /// lookup order placement validates against.
  ///
  /// Not the same state as `is_available`. That one is "sold out tonight", a
  /// shift may set it, and it comes back. This one needs `menu:write` and
  /// nothing in the panel undoes it.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     RestaurantBranch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category   Category?         @relation(fields: [categoryId], references: [id])
  /// Restrict, not cascade: deleting a section must never delete the food. The
  /// panel moves the dishes first, or the delete is refused.
  section    BranchMenuSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  favorites  FavoriteMenuItem[]

  @@index([branchId, sectionId])
  @@index([sectionId])
  @@index([categoryId])
  @@map("menu_items")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  /// The order's name: `AMR-` + 8 digits. Printed on the ticket, read out over
  /// the phone, scanned off the board. It identifies an order; it does not
  /// prove anything about one — see `pickup_code`.
  code            String        @unique @db.VarChar(12)
  /// The number a guest shows to collect the food, and the only thing that lets
  /// the counter close the order. Six digits, generated in its own right.
  ///
  /// **Not derived from `code`, and that is the whole design.** It used to be
  /// its last four digits — never stored, so the two could not disagree — which
  /// also meant every receipt, screenshot and shoulder carrying the order
  /// number carried the collection code with it. A proof derived from a public
  /// name proves nothing, so this is drawn independently and stored.
  ///
  /// Unique across the table, not per branch: a code is checked against the one
  /// order somebody is standing in front of, but making it globally unique
  /// means a mistyped code can never quietly match a *different* live order.
  /// That caps the platform at 1,000,000 orders ever — see DATABASE.md §5,
  /// which is also where the two ways out are written down. Inserting past that
  /// point fails on this constraint rather than reusing a code.
  pickupCode      String        @unique @map("pickup_code") @db.VarChar(6)
  userId          String        @map("user_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  serviceMode     ServiceMode   @map("service_mode")
  /// Where a pickup order ends up: taken away, or eaten in the dining room
  /// unserved. The kitchen reads it, because a bag and a plate are not the same
  /// order to prepare and the counter is too late to ask.
  ///
  /// **Set exactly when `service_mode` is `pickup`** — a dine-in order has a
  /// table instead, and there is no such thing as taking away a meal you are
  /// sitting at. A CHECK constraint holds the two to that
  /// (`orders_pickup_option_matches_service_mode`); Prisma cannot express it, so
  /// it lives in the migration and in DATABASE.md §5.
  ///
  /// `eat_in` is only accepted from a restaurant that declares the matching
  /// service — see BUSINESS_LOGIC.md §2, where it is also why such a restaurant
  /// cannot be doing table service.
  pickupOption    PickupOption? @map("pickup_option")
  status          OrderStatus   @default(created)
  subtotalAmd     Int           @map("subtotal_amd")
  serviceFeeAmd   Int           @map("service_fee_amd")
  depositAmd      Int           @default(0) @map("deposit_amd")
  // What a coupon took off, and which coupon did it. Stored rather than
  // recomputed: the coupon's percentage may change later (referral discounts
  // accumulate), and an order must keep saying what was actually charged.
  discountAmd     Int           @default(0) @map("discount_amd")
  couponId        String?       @map("coupon_id") @db.Uuid
  totalAmd        Int           @map("total_amd")
  readyAt         DateTime?     @map("ready_at") @db.Timestamptz(6)
  /// The prep estimate this order was priced and scheduled against, in minutes —
  /// the slowest dish, or the branch average, or `DEFAULT_PREP_MIN`. A snapshot
  /// for the same reason `order_items.unit_price_amd` is one: the dish's
  /// `prep_min` may change, and an order must keep saying what it was promised
  /// against. Null on rows written before pre-ordering existed, which is the
  /// honest answer for them — nothing recorded it.
  prepMin         Int?          @map("prep_min") @db.SmallInt
  /// When the kitchen has to start, so the food is ready when it was promised —
  /// `ready_at` minus `prep_min`. Stored rather than recomputed because it is
  /// what the board sorts on, and a sort key derived per row is a sort the
  /// database cannot do.
  prepStartAt     DateTime?     @map("prep_start_at") @db.Timestamptz(6)
  /// How long before `ready_at` the branch is warned, in minutes — the number
  /// `reminder_at` is computed from, and the one the shift may move.
  ///
  /// Defaulted to `prep_min` + `PREP_REMINDER_BUFFER_MIN` when the order is
  /// placed, which is the arithmetic that was already there. An operator who
  /// knows the dish better than the estimate does raises it: a skewer wants
  /// lighting the coals before it wants cooking, and forty-five minutes of
  /// notice is a thing a person knows and a menu column does not.
  ///
  /// Null exactly when `reminder_at` is null — the two are set together and
  /// cleared together, because a lead with nothing to lead is a number that
  /// means nothing, and a reminder with no lead could not be explained.
  reminderLeadMin Int?          @map("reminder_lead_min") @db.SmallInt
  /// When to warn the branch that this one is coming up: `ready_at` minus
  /// `reminder_lead_min`.
  ///
  /// **Null means the order was placed for as soon as possible**, and that is
  /// the whole of what distinguishes a pre-order from an ordinary one. Nothing
  /// needs reminding about an order that is already the kitchen's problem, so
  /// the column that schedules the reminder is also the flag for having been
  /// scheduled — the same doubling-up `reservations.active_slot` uses, and for
  /// the same reason: two columns that must always agree eventually will not.
  ///
  /// It is also the boundary the Scheduled stage is drawn on. Still in the
  /// future, and the order is a booking; passed, and it is this shift's work.
  /// By the clock rather than by `reminder_sent_at`, so an order still lands on
  /// the board on time in a deployment where the reminder job never ran.
  reminderAt      DateTime?     @map("reminder_at") @db.Timestamptz(6)
  /// Set by the reminder job once it has told the branch. Only ever read to stop
  /// it telling them twice — never to decide which stage an order is in.
  ///
  /// Cleared again when a shift lengthens `reminder_lead_min` past the point the
  /// warning already went out: the earlier notice was for a moment that is no
  /// longer the one anybody chose, and leaving this set would mean the new time
  /// silently never fires.
  reminderSentAt  DateTime?     @map("reminder_sent_at") @db.Timestamptz(6)
  reservationId   String?       @unique @map("reservation_id") @db.Uuid
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                @relation(fields: [userId], references: [id])
  branch        RestaurantBranch    @relation(fields: [branchId], references: [id])
  reservation   Reservation?        @relation(fields: [reservationId], references: [id])
  coupon        Coupon?             @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  payment       Payment?
  events        OrderEvent[]
  notifications StaffNotification[]

  @@index([userId, status])
  @@index([branchId, status])
  /// The board splits every stage on "is this due yet", and sorts on when the
  /// kitchen has to start. One branch's queue, in the order it will be worked.
  @@index([branchId, reminderAt, prepStartAt])
  @@index([code])
  @@map("orders")
}

/// Everything that ever happened to an order, in the order it happened.
///
/// `orders.status` says where an order is; this says how it got there and who
/// moved it. The two are not the same question, and the second one only has an
/// answer if it is written down as it happens — a status column overwrites its
/// own history on every update.
///
/// Not `audit_log`: that table names a `staff_users` actor, and most of what
/// happens to an order is done by the customer who placed it or by the payment
/// provider. Folding those into a table whose actor column is a staff id would
/// mean a NULL actor for the majority of rows, which is precisely the question
/// this exists to answer.
model OrderEvent {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  type          OrderEventType
  /// Null for `created` (there was no previous status) and for `payment`
  /// entries, which record an attempt that moved nothing.
  fromStatus    OrderStatus?   @map("from_status")
  toStatus      OrderStatus?   @map("to_status")
  actorType     OrderActorType @map("actor_type")
  /// Set when `actor_type = customer`.
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  /// Set when `actor_type = staff`.
  actorStaffId  String?        @map("actor_staff_id") @db.Uuid
  /// The real human behind an impersonated session, when the staff member above
  /// was being acted as rather than acting. Null in the ordinary case. Without
  /// it the timeline would name the person who did not do it — the exact
  /// failure `ImpersonationService` writes `audit_log` to avoid.
  actingStaffId String?        @map("acting_staff_id") @db.Uuid
  /// Whatever the entry needs beyond the statuses: the payment method and what
  /// happened to the money, the reason a cancellation was allowed. Shaped per
  /// `type` and read only for display, so a new kind of detail is not a
  /// migration.
  detail        Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User?      @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorStaff  StaffUser? @relation("OrderEventStaffActor", fields: [actorStaffId], references: [id], onDelete: SetNull)
  actingStaff StaffUser? @relation("OrderEventActingStaff", fields: [actingStaffId], references: [id], onDelete: SetNull)

  /// The timeline is always read for one order, oldest first.
  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderItem {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  menuItemId   String @map("menu_item_id") @db.Uuid
  nameSnapshot String @map("name_snapshot") @db.VarChar(160)
  unitPriceAmd Int    @map("unit_price_amd")
  qty          Int    @db.SmallInt
  lineTotalAmd Int    @map("line_total_amd")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  reservedFor     DateTime          @map("reserved_for") @db.Timestamptz(6)
  /// Which day's book this booking belongs on — the service day, not the
  /// calendar day of `reserved_for`.
  ///
  /// The two differ only where a night runs past midnight, and there they
  /// differ in the way that matters most: a branch open 12:00–02:00 offers
  /// 00:30 as the last start of *Tuesday's* evening, and that instant's own
  /// calendar date is Wednesday. Filtering the book by calendar date put those
  /// guests on Wednesday's page — invisible to the shift that was still
  /// working when they walked in, and sitting above a service that had not
  /// opened yet.
  ///
  /// Stored rather than recomputed for the same reason `seating_minutes` is:
  /// it is decided by the hours in force when the booking was taken, and a
  /// branch that shortens its night next month must not silently move guests
  /// who are already in the book to another day.
  serviceDate     DateTime          @map("service_date") @db.Date
  guests          Int               @db.SmallInt
  /// How long this booking holds its table, snapshotted when it was made — the
  /// same reason `orders.prep_min` is a snapshot rather than a lookup.
  ///
  /// A branch that lengthens its seating from 90 minutes to 120 has changed
  /// what it offers from now on; it has not changed what it already promised
  /// four people for Friday. Reading the live policy instead would silently
  /// stretch every accepted booking, and two of them that fitted an hour apart
  /// would begin to overlap on the same table — an overlap no constraint would
  /// catch, because the unique index guards the start instant and the
  /// serializable transaction that checks intervals has long since committed.
  ///
  /// NULL on rows written before this column existed, which is the honest
  /// answer for them: nothing recorded it. Readers fall back to the resolved
  /// policy, exactly as they did when there was nothing else to read.
  seatingMinutes  Int?              @map("seating_minutes") @db.SmallInt
  depositAmd      Int               @map("deposit_amd")
  /// How many hours before the sitting this booking's deposit stops being
  /// refundable — snapshotted for the same reason `deposit_amd` is.
  ///
  /// The two are one promise: *this much money, returnable until then*. Half of
  /// it was already frozen and the other half was read live, so a branch that
  /// moved its cancellation window from two hours to twenty-four moved it for
  /// people who had already paid — changing the terms of an agreement after the
  /// guest accepted them. Refunds are decided from this column, so a policy
  /// change now applies to bookings made after it and no others.
  ///
  /// NULL on rows written before it existed; readers fall back to the resolved
  /// policy, which is what decided them at the time.
  freeCancelHours Int?              @map("free_cancel_hours") @db.SmallInt
  depositCredited Boolean           @default(false) @map("deposit_credited")
  status          ReservationStatus @default(pending)
  // Mirrors `reservedFor` while this booking holds the table, and is set to
  // NULL the moment it stops (cancelled/no-show/completed). Postgres treats
  // NULLs in a unique index as distinct, which is exactly the wanted
  // behaviour: see the @@unique below.
  activeSlot      DateTime?         @map("active_slot") @db.Timestamptz(6)
  /// When the guest was reminded that this table is coming up, or NULL if they
  /// have not been.
  ///
  /// A marker, not a schedule: the moment to send is derived from
  /// `reserved_for` and a fixed lead, and this only records that it happened.
  /// Written in the same transaction as the notification it describes, so a
  /// reminder cannot be sent twice — the sweep claims a row by matching on this
  /// still being NULL, exactly as `orders.reminder_sent_at` does.
  reminderSentAt  DateTime?         @map("reminder_sent_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User             @relation(fields: [userId], references: [id])
  branch  RestaurantBranch @relation(fields: [branchId], references: [id])
  table   Table?           @relation(fields: [tableId], references: [id])
  order   Order?
  payment Payment?

  // One table can be held by one live booking per start time. Keyed on
  // `activeSlot` rather than `reservedFor` so that cancelling frees the slot
  // instead of blocking it forever.
  //
  // The overlap check (a seating spans several slots) runs inside a
  // serializable transaction; this constraint is the guarantee that still
  // holds if that isolation level is ever relaxed, and it covers the
  // collision that matters most — everybody books on the half hour.
  @@unique([tableId, activeSlot])
  @@index([branchId, reservedFor])
  // The staff book is always "this branch, this service day", so that is the
  // index it gets. `[branchId, reservedFor]` stays: availability still asks for
  // an interval around a slot, which a date column cannot answer.
  @@index([branchId, serviceDate])
  @@index([userId])
  @@map("reservations")
}

// A payment settles exactly one of two things: an order (food) or a
// reservation (a table deposit). Both columns are nullable with a CHECK
// constraint enforcing exactly one — see the `payment_target` migration.
// The alternative, a second `deposits` table, would duplicate every provider
// field and every status transition for no gain.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  reservationId String?       @unique @map("reservation_id") @db.Uuid
  method        PaymentMethod
  amountAmd     Int           @map("amount_amd")
  status        PaymentStatus @default(pending)
  providerRef   String?       @map("provider_ref") @db.VarChar(120)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  rating       Int      @db.SmallInt
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("reviews")
}

model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  type   NotificationType

  /// The words, **when the server is the one who wrote them** — a promo, a
  /// system note. Null for the kinds a client renders itself, which is every
  /// `order` row: those carry `payload` instead and the client draws them from
  /// the dictionary it already ships (`statusReady`, `statusReadyDesc`, …).
  ///
  /// Nullable rather than always filled, because the alternative is a sentence
  /// frozen in whatever language the reader preferred the day it was written.
  /// Switching language in Settings would then leave a bell half-translated,
  /// and the API cannot reach the shared dictionary to avoid that: it compiles
  /// to CommonJS with Node resolution, and `@amragrir/i18n` ships TypeScript
  /// that only a bundler reads. The same reasoning is already written down for
  /// `staff_notifications` below — a row carries the facts, not a sentence.
  title String? @db.VarChar(160)
  body  String?

  /// What the row is about, structured. For `order`: `{ orderId, code, status }`
  /// — enough for the bell to name the order and deep-link to it without a
  /// second request.
  payload   Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// A saved **branch**, not a saved business.
///
/// Everything a customer acts on in this product is a branch: a card on the feed
/// is a branch, a basket is opened against a branch, a table is booked at a
/// branch. A favourite stored against the restaurant was the one exception, and
/// it showed — hearting one address of a chain filled the heart on every other
/// address of it, and the Favourites list could not say which kitchen it meant.
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@map("favorites")
}

/// A saved **dish**, which is a different thing from a saved branch and is why
/// it is a table of its own rather than two nullable columns on `favorites`.
///
/// A dish belongs to one branch (`menu_items.branch_id`), so saving one already
/// says which kitchen — the khinkali at the Abovyan St address, not "khinkali
/// at Dolmama". That keeps the branch-is-the-subject rule of `favorites`
/// (DATABASE.md §13) without restating it here: the branch travels with the
/// dish through the foreign key.
///
/// Nothing is stored *about* the dish — not its name, not its price. The menu
/// is the authority on both, so a saved dish that is renamed or repriced shows
/// what the kitchen says today, and one taken off the menu (`deleted_at`) is
/// filtered out of the list rather than drawn as a dish nobody can order.
model FavoriteMenuItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
  @@map("favorite_menu_items")
}

model Referral {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  code              String   @unique @db.VarChar(16)
  invitedCount      Int      @default(0) @map("invited_count")
  discountEarnedPct Int      @default(0) @map("discount_earned_pct")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model Coupon {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  code        String       @db.VarChar(20)
  discountPct Int?         @map("discount_pct") @db.SmallInt
  discountAmd Int?         @map("discount_amd")
  source      CouponSource
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  usedAt      DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  // A code is unique per user, not globally: a referral reward is a personal
  // coupon, and two people may hold the same friendly code.
  @@unique([userId, code])
  @@index([userId])
  @@map("coupons")
}

// ── Staff side ───────────────────────────────────────────────────────────────
// Separate from `users` on purpose: a person who manages a restaurant should not
// also be carrying reward points, favourites and an order history on the same
// row, and no customer record should be one UPDATE away from staff powers.
// Someone who both manages a restaurant and eats at one has two accounts.

model StaffUser {
  id              String    @id @default(uuid()) @db.Uuid
  /// Always stored lowercased — the API normalises before writing, so this
  /// unique index is the real one rather than a case-sensitive near-miss.
  email           String    @unique @db.VarChar(160)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  /// Null until an invite is accepted: the account exists so it can be assigned
  /// a role and shown in a list, but it cannot be signed into yet.
  passwordHash    String?   @map("password_hash")
  name            String    @db.VarChar(120)
  /// Contact only — never a login. Staff sign in with email.
  phone           String?   @db.VarChar(20)
  /// Deactivation rather than deletion: `audit_log` has to keep naming them.
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments       StaffAssignment[]       @relation("AssignmentHolder")
  grantedRoles      StaffAssignment[]       @relation("AssignmentGrantedBy")
  invitesSent       StaffInvite[]           @relation("InviteSentBy")
  auditEntries      AuditLog[]
  /// Entries written while acting as somebody else — see `AuditLog.actingStaffId`.
  auditEntriesAs    AuditLog[]              @relation("AuditLogActingStaff")
  orderEvents       OrderEvent[]            @relation("OrderEventStaffActor")
  /// Orders moved while acting as somebody else — see `OrderEvent.actingStaffId`.
  orderEventsAs     OrderEvent[]            @relation("OrderEventActingStaff")
  /// Branch notifications this person has read — see `StaffNotificationRead`.
  notificationReads StaffNotificationRead[]

  @@map("staff_users")
}

/// One role, over one scope. A manager of two branches holds two rows — which
/// is what makes "manage these two, not the third" expressible at all, and is
/// why this is a table rather than a column on `staff_users`.
model StaffAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  staffUserId  String    @map("staff_user_id") @db.Uuid
  role         StaffRole
  /// Set for `restaurant_admin`; null otherwise.
  restaurantId String?   @map("restaurant_id") @db.Uuid
  /// Set for `restaurant_manager` and `branch_staff`; null otherwise. The
  /// restaurant is reached by joining the branch, so the two columns can never
  /// disagree about which restaurant this is.
  branchId     String?   @map("branch_id") @db.Uuid
  /// Who granted it. Null once that account is deleted — the grant outlives the
  /// granter, and losing the name is better than losing the row.
  createdById  String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staffUser  StaffUser         @relation("AssignmentHolder", fields: [staffUserId], references: [id], onDelete: Cascade)
  createdBy  StaffUser?        @relation("AssignmentGrantedBy", fields: [createdById], references: [id], onDelete: SetNull)
  restaurant Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // The role/scope shape (platform roles carry neither id, restaurant roles a
  // restaurant, branch roles a branch) is a CHECK constraint in the migration —
  // Prisma cannot express it, and without it a malformed row is a privilege bug
  // rather than a validation error. The "one assignment per person per scope"
  // rule is a set of partial unique indexes there too, because Postgres treats
  // NULLs as distinct and a plain @@unique would allow duplicates.
  @@index([staffUserId])
  @@index([restaurantId])
  @@index([branchId])
  @@map("staff_assignments")
}

/// How a staff account comes into existence. There is no sign-up: an account is
/// created by someone who already has the right to create it, which is what
/// makes "no customer can become staff" true rather than merely enforced.
model StaffInvite {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @db.VarChar(160)
  role         StaffRole
  restaurantId String?   @map("restaurant_id") @db.Uuid
  branchId     String?   @map("branch_id") @db.Uuid
  /// Only the hash is stored. The raw token exists in the email and nowhere
  /// else, so a leaked database does not hand over usable invitations.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  invitedById  String    @map("invited_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy  StaffUser         @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: Cascade)
  restaurant Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("staff_invites")
}

/// Something a branch needs telling about, addressed to the branch rather than
/// to a person.
///
/// Not a staff-side copy of `notifications`. That table has a `user_id` and is
/// one customer's inbox; this one has a `branch_id`, because a shift is not a
/// person — whoever is holding the tablet needs to see that a pre-order is
/// coming up, and which of the three people assigned to the branch that is
/// changes hourly. Fanning one reminder out into a row per assigned staff member
/// would instead make "who is on tonight" a thing the writer has to know, and
/// would leave the notification undeliverable to somebody assigned five minutes
/// later.
///
/// Reach follows the same rule as everything else in the back office: a row is
/// readable by an account whose `orders:read` scope covers its branch.
///
/// **Nothing here is prose.** A reminder is written by a job, and a job has no
/// request to take a language from — writing "Салат нужно начать" at 3am would
/// pick a language for a reader who has not arrived yet. The row carries the
/// type and the numbers, and the panel renders them through its own dictionary,
/// exactly as it does for order statuses and history entries.
model StaffNotification {
  id        String                @id @default(uuid()) @db.Uuid
  branchId  String                @map("branch_id") @db.Uuid
  type      StaffNotificationType
  /// What it is about, when it is about an order. Nullable because a later type
  /// need not be — and `ON DELETE CASCADE`, since a notification pointing at an
  /// order that is gone has nothing left to say.
  orderId   String?               @map("order_id") @db.Uuid
  /// The numbers the panel needs to render the line — pickup code, the time it
  /// is due, how long it takes. Shaped per `type` and read only for display, so
  /// a new kind of reminder is not a migration.
  payload   Json?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  branch RestaurantBranch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order  Order?                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reads  StaffNotificationRead[]

  /// One branch's bell, newest first.
  @@index([branchId, createdAt])
  @@map("staff_notifications")
}

/// That one person has seen one notification.
///
/// A join table rather than an `is_read` column on the row above, because the
/// row above belongs to a branch and being read is something a *person* does.
/// A single flag would mean the first colleague to open the bell clears it for
/// everyone else on the shift — which is precisely the failure a kitchen
/// notification exists to avoid.
model StaffNotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  staffUserId    String   @map("staff_user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  notification StaffNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  staffUser    StaffUser         @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@id([notificationId, staffUserId])
  @@index([staffUserId])
  @@map("staff_notification_reads")
}

/// Who did what. Once two people share a restaurant, "who marked this sold out"
/// and "who let this account in" stop being answerable without it.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  /// Null for actions the system took on nobody's behalf, and for staff who
  /// have since been deleted.
  actorStaffId  String?  @map("actor_staff_id") @db.Uuid
  /// The real human behind an impersonated session, when the account above was
  /// being acted as rather than acting. Null in the ordinary case. Without it an
  /// impersonated change is filed against the innocent party — the same failure
  /// `order_events.acting_staff_id` exists to prevent.
  actingStaffId String?  @map("acting_staff_id") @db.Uuid
  /// `menu_item.update`, `staff.invite`, `order.status` — resource and verb.
  action        String   @db.VarChar(80)
  entity        String   @db.VarChar(40)
  /// Not a foreign key: it points at whichever table `entity` names, and the
  /// row it refers to may legitimately be gone.
  entityId      String?  @map("entity_id") @db.Uuid
  /// Where it happened, so a person's activity can be filtered to the reader's
  /// reach without a join per `entity` value. Both are written wherever both are
  /// known — a menu item names its branch, and that branch names its restaurant.
  ///
  /// Both null means platform scope: an action over no restaurant, readable only
  /// by an account whose reach is unscoped. Unlike `entity_id` these are real
  /// references, because they decide who may read the row and an access-control
  /// column holding an id that matches nothing hides or reveals history by
  /// accident.
  restaurantId  String?  @map("restaurant_id") @db.Uuid
  branchId      String?  @map("branch_id") @db.Uuid
  /// Only the fields that changed, not the whole row. `before` is what makes a
  /// deletion readable — it is the only remaining record of what the thing was
  /// called, for the entities that are not soft-deleted.
  before        Json?
  after         Json?
  ip            String?  @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor       StaffUser?        @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  actingStaff StaffUser?        @relation("AuditLogActingStaff", fields: [actingStaffId], references: [id], onDelete: SetNull)
  restaurant  Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  branch      RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /// One person, newest first — scanned backwards for the activity feed.
  @@index([actorStaffId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}
