// Amragrir.am database schema — see docs/DATABASE.md for the source of truth.
// Money is stored as AMD integer (dram has no minor unit). Timestamps are timestamptz.
// Keep this schema and docs/DATABASE.md in sync; log changes in docs/CHANGELOG.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (mirror packages/shared/src/enums.ts) ──────────────────────────────
// `guest` is not a DB role — it is the `users.isGuest` flag (see ROLES_AND_PERMISSIONS.md).

enum Role {
  customer
  owner
  staff
  admin
}

enum ServiceMode {
  pickup
  dine_in
}

enum OrderStatus {
  created
  paid
  confirmed
  preparing
  almost_ready
  ready
  completed
  cancelled
}

enum ReservationStatus {
  pending
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum PaymentMethod {
  apple_pay
  google_pay
  card
  cash
}

enum PaymentStatus {
  pending
  authorized
  captured
  refunded
  failed
  cancelled
}

enum MenuTab {
  popular
  mains
  sides
  drinks
}

enum NotificationType {
  order
  reservation
  promo
  referral
  system
}

enum CouponSource {
  referral
  reward
  promo
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid()) @db.Uuid
  // Nullable because guest accounts exist before any phone is known; it is
  // filled in when the user verifies an OTP (guest -> customer upgrade).
  phone         String?  @unique @db.VarChar(20)
  phoneVerified Boolean  @default(false) @map("phone_verified")
  name          String?  @db.VarChar(120)
  email         String?  @unique @db.VarChar(160)
  avatarUrl     String?  @map("avatar_url")
  language      String   @default("hy") @db.VarChar(2)
  darkMode      Boolean  @default(false) @map("dark_mode")
  notifPush     Boolean  @default(true) @map("notif_push")
  notifPromo    Boolean  @default(false) @map("notif_promo")
  rewardPoints  Int      @default(0) @map("reward_points")
  role          Role     @default(customer)
  referredById  String?  @map("referred_by") @db.Uuid
  isGuest       Boolean  @default(false) @map("is_guest")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  referredBy       User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]         @relation("UserReferrals")
  ownedRestaurants Restaurant[]   @relation("OwnedRestaurants")
  orders           Order[]
  reservations     Reservation[]
  favorites        Favorite[]
  reviews          Review[]
  notifications    Notification[]
  referral         Referral?
  coupons          Coupon[]

  @@map("users")
}

model Restaurant {
  id                   String   @id @default(uuid()) @db.Uuid
  slug                 String   @unique @db.VarChar(80)
  name                 String   @db.VarChar(160)
  cuisine              String?  @db.VarChar(120)
  priceLevel           Int?     @map("price_level") @db.SmallInt
  ratingAvg            Decimal  @default(0) @map("rating_avg") @db.Decimal(2, 1)
  reviewsCount         Int      @default(0) @map("reviews_count")
  ownerId              String   @map("owner_id") @db.Uuid
  reservationsEnabled  Boolean  @default(false) @map("reservations_enabled")
  services             String[]
  coverUrl             String?  @map("cover_url")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User               @relation("OwnedRestaurants", fields: [ownerId], references: [id])
  branches  RestaurantBranch[]
  reviews   Review[]
  favorites Favorite[]

  @@index([ownerId])
  @@map("restaurants")
}

model RestaurantBranch {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String?  @db.VarChar(160)
  address      String?
  city         String   @default("Yerevan") @db.VarChar(80)
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  phone        String?  @db.VarChar(20)
  openHours    Json?    @map("open_hours")
  isOpen       Boolean  @default(true) @map("is_open")
  avgPrepMin   Int?     @map("avg_prep_min") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       Table[]
  menuItems    MenuItem[]
  orders       Order[]
  reservations Reservation[]

  @@index([restaurantId])
  @@index([lat, lng])
  @@map("restaurant_branches")
}

model Table {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String  @map("branch_id") @db.Uuid
  tableNo  String  @map("table_no") @db.VarChar(10)
  seats    Int     @db.SmallInt
  zone     String? @db.VarChar(40)
  isActive Boolean @default(true) @map("is_active")

  branch       RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([branchId])
  @@map("tables")
}

model Category {
  id        String @id @default(uuid()) @db.Uuid
  key       String @unique @db.VarChar(40)
  icon      String? @db.VarChar(8)
  sortOrder Int?    @map("sort_order") @db.SmallInt
  nameI18n  Json   @map("name_i18n")

  menuItems MenuItem[]

  @@map("categories")
}

model MenuItem {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  categoryId   String?  @map("category_id") @db.Uuid
  menuTab      MenuTab  @map("menu_tab")
  nameI18n     Json     @map("name_i18n")
  descI18n     Json?    @map("desc_i18n")
  priceAmd     Int      @map("price_amd")
  caloriesKcal Int?     @map("calories_kcal")
  prepMin      Int?     @map("prep_min") @db.SmallInt
  photoUrl     String?  @map("photo_url")
  dietaryTags  String[] @map("dietary_tags")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch     RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([branchId, menuTab])
  @@index([categoryId])
  @@map("menu_items")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique @db.VarChar(12)
  userId        String      @map("user_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  serviceMode   ServiceMode @map("service_mode")
  status        OrderStatus @default(created)
  subtotalAmd   Int         @map("subtotal_amd")
  serviceFeeAmd Int         @map("service_fee_amd")
  depositAmd    Int         @default(0) @map("deposit_amd")
  // What a coupon took off, and which coupon did it. Stored rather than
  // recomputed: the coupon's percentage may change later (referral discounts
  // accumulate), and an order must keep saying what was actually charged.
  discountAmd   Int         @default(0) @map("discount_amd")
  couponId      String?     @map("coupon_id") @db.Uuid
  totalAmd      Int         @map("total_amd")
  readyAt       DateTime?   @map("ready_at") @db.Timestamptz(6)
  reservationId String?     @unique @map("reservation_id") @db.Uuid
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id])
  branch      RestaurantBranch @relation(fields: [branchId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  payment     Payment?

  @@index([userId, status])
  @@index([branchId, status])
  @@index([code])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  menuItemId   String @map("menu_item_id") @db.Uuid
  nameSnapshot String @map("name_snapshot") @db.VarChar(160)
  unitPriceAmd Int    @map("unit_price_amd")
  qty          Int    @db.SmallInt
  lineTotalAmd Int    @map("line_total_amd")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Reservation {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  tableId         String?           @map("table_id") @db.Uuid
  reservedFor     DateTime          @map("reserved_for") @db.Timestamptz(6)
  guests          Int               @db.SmallInt
  depositAmd      Int               @map("deposit_amd")
  depositCredited Boolean           @default(false) @map("deposit_credited")
  status          ReservationStatus @default(pending)
  // Mirrors `reservedFor` while this booking holds the table, and is set to
  // NULL the moment it stops (cancelled/no-show/completed). Postgres treats
  // NULLs in a unique index as distinct, which is exactly the wanted
  // behaviour: see the @@unique below.
  activeSlot      DateTime?         @map("active_slot") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User             @relation(fields: [userId], references: [id])
  branch  RestaurantBranch @relation(fields: [branchId], references: [id])
  table   Table?           @relation(fields: [tableId], references: [id])
  order   Order?
  payment Payment?

  // One table can be held by one live booking per start time. Keyed on
  // `activeSlot` rather than `reservedFor` so that cancelling frees the slot
  // instead of blocking it forever.
  //
  // The overlap check (a seating spans several slots) runs inside a
  // serializable transaction; this constraint is the guarantee that still
  // holds if that isolation level is ever relaxed, and it covers the
  // collision that matters most — everybody books on the half hour.
  @@unique([tableId, activeSlot])
  @@index([branchId, reservedFor])
  @@index([userId])
  @@map("reservations")
}

// A payment settles exactly one of two things: an order (food) or a
// reservation (a table deposit). Both columns are nullable with a CHECK
// constraint enforcing exactly one — see the `payment_target` migration.
// The alternative, a second `deposits` table, would duplicate every provider
// field and every status transition for no gain.
model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String?       @unique @map("order_id") @db.Uuid
  reservationId String?       @unique @map("reservation_id") @db.Uuid
  method        PaymentMethod
  amountAmd     Int           @map("amount_amd")
  status        PaymentStatus @default(pending)
  providerRef   String?       @map("provider_ref") @db.VarChar(120)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  orderId      String?  @map("order_id") @db.Uuid
  rating       Int      @db.SmallInt
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String
  payload   Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Favorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@map("favorites")
}

model Referral {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  code              String   @unique @db.VarChar(16)
  invitedCount      Int      @default(0) @map("invited_count")
  discountEarnedPct Int      @default(0) @map("discount_earned_pct")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

model Coupon {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  code        String       @db.VarChar(20)
  discountPct Int?         @map("discount_pct") @db.SmallInt
  discountAmd Int?         @map("discount_amd")
  source      CouponSource
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  usedAt      DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  // A code is unique per user, not globally: a referral reward is a personal
  // coupon, and two people may hold the same friendly code.
  @@unique([userId, code])
  @@index([userId])
  @@map("coupons")
}
