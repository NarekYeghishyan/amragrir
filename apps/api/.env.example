# Copy to apps/api/.env and adjust as needed.
# Values below match the local docker-compose.yml at the repo root.
# Keep comments on their own line — inline `# ...` after a value is not
# stripped by every parser and would break numeric validation.

PORT=3000

# Postgres (docker compose service `postgres`)
DATABASE_URL="postgresql://amragrir:amragrir@localhost:5432/amragrir?schema=public"

# Redis (docker compose service `redis`) — OTP storage and refresh-token registry
REDIS_URL="redis://localhost:6379"

# Auth — MUST be replaced with a real secret outside local dev (min 16 chars)
JWT_SECRET="dev-only-change-me-please"

# Access token lifetime, seconds (15 min)
JWT_ACCESS_TTL=900

# Refresh token lifetime, seconds (30 days)
JWT_REFRESH_TTL=2592000

# OTP code validity, seconds
OTP_TTL=120

# Minimum gap between OTP sends to one phone, seconds
OTP_RESEND_COOLDOWN=60

# Wrong tries before the code is burned
OTP_MAX_ATTEMPTS=5

# Where the back office runs. Staff invite and password-reset links are built
# from this, so a wrong value produces emails nobody can act on.
ADMIN_URL="http://localhost:5173"

# How long a staff invitation stays open, seconds (7 days)
STAFF_INVITE_TTL=604800

# How long a staff password-reset link lives, seconds (30 min)
STAFF_RESET_TTL=1800

# Where this API is reachable from a browser. Uploaded menu photos are stored
# as absolute URLs built from it, so changing it after photos exist leaves the
# old ones pointing at the old host.
API_PUBLIC_URL="http://localhost:3000"

# Where uploaded images are written. Relative paths resolve against the process
# working directory (apps/api when run with the scripts here). Served back at
# API_PUBLIC_URL/uploads/... — keep it on a volume that survives a deploy.
UPLOAD_DIR="./uploads"

# Which pictures the seed gives demo dishes. Unset (the default) hotlinks real
# photographs from TheMealDB/TheCocktailDB and Wikimedia Commons — see
# prisma/menu-photos.ts. Set to "local" for the committed placeholders in
# public/menu, which is what a demo with no way out to the internet wants.
# Read only by prisma/seed.ts and prisma/refresh-photos.ts; the API never sees it.
# MENU_PHOTOS="local"

# Comma-separated allowed origins for CORS; leave unset to allow all in dev.
# CORS_ORIGIN="http://localhost:3001,http://localhost:19006"

# Reverse proxies in front of the app (nginx/ALB = 1). MUST be set in any
# deployment behind a proxy or per-IP rate limiting sees only the proxy and
# throttles all users as one. Keep 0 when exposed directly.
TRUST_PROXY_HOPS=0

# Yandex Geocoder key for GET /geocode — the address search behind the phone's
# location picker (and available to any other client that needs one). The same
# key the web app holds for its own /geocode route; this one is separate because
# the two processes are separate, not because the keys differ.
#
# Optional. Unset, GET /geocode answers { items: [], available: false } and the
# app draws no search box: the map still takes any point, named after the
# nearest district. That is better than a key that fails, which reads to a
# customer as "this address does not exist".
#
# Test a key against the geocoder itself — api-maps.yandex.ru answers 200 for
# any key at all and proves nothing:
#   curl "https://geocode-maps.yandex.ru/1.x/?apikey=KEY&format=json&geocode=Yerevan"
YANDEX_GEOCODER_API_KEY=
